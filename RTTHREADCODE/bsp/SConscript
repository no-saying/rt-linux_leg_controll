import os
from building import *

cwd = GetCurrentDir()
directories = ['board', 'amp', 'can', 'dma', 'diag', 'dwt', 'log', 'periph',
               'spi', 'usart']
src = []
paths = [cwd]
for directory in directories:
    src += Glob(os.path.join(directory, '*.c'))
    paths.append(os.path.join(cwd, directory))
group = DefineGroup('BSP', src, depend=[''], CPPPATH=paths)
Return('group')
